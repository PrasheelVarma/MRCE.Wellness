# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
#
# These values are NOT loaded as a file at runtime.
# They must be passed at build / run time via --dart-define:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=your_anon_key_here
#
#   flutter build apk \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=your_anon_key_here
#
# For CI/CD (GitHub Actions etc.) store these as repository secrets
# and inject them as --dart-define arguments in your workflow file.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
